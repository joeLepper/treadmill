[Unit]
Description=Treadmill router integrator — host-side approve->integration executor (ADR-0119)
# Runs on the rainbow HOST as the OPERATOR (never in the api container): polls
# GET /api/v1/integration_queue and merges each approved task's PR into its plan's
# joes-agents/<slug> branch, as the operator's gh identity, via the local-git merger.
# The push closes the PR -> github.pr_merged -> the router unblocks dependents.
# See AGENT.md for the credential provisioning + the full enable runbook.
#
# NOT auto-enabled: shipping this unit does not start it. Enabling begins AUTONOMOUS
# git merges to collaborator repos AS THE OPERATOR -- the operator's call:
#   systemctl --user enable --now treadmill-router-integrator
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/treadmill/services/api
Environment=TREADMILL_API_URL=http://localhost:8088
Environment=ROUTER_INTEGRATOR_STATE_DIR=%h/.treadmill/router-clones
# The OPERATOR git identity for integration commits (ADR-0119). MUST match a verified email on
# the operator's GitHub account so merge commits ATTRIBUTE to the operator (not the
# treadmill-router fallback). Set these to the operator's gh identity before enabling.
Environment=ROUTER_INTEGRATOR_GIT_NAME=Joe Lepper
Environment=ROUTER_INTEGRATOR_GIT_EMAIL=josephlepper@gmail.com
# The operator's NON-INTERACTIVE git push credential must be reachable by this unit
# (a git credential helper / gh token or an ssh key) -- an interactive gh keychain is NOT
# available to a systemd unit. See AGENT.md "Credential".
ExecStart=/usr/bin/env uv run --project %h/treadmill/services/api python -m treadmill_api.router_integrator
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
