# Copy to ~/model-gateway/secret.env and chmod 600. NEVER commit the real file.
# Master key gates the gateway; the panel and any caller present it as a bearer token.
export GATEWAY_MASTER_KEY=sk-fleet-REPLACE_WITH_RANDOM
# OpenCode Go key (open-weight catalog). Same $10/mo subscription key.
export OPENCODE_API_KEY=sk-REPLACE_ME
