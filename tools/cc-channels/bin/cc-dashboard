#!/usr/bin/env bash
# cc-dashboard — one-row, five-column operator dashboard for all labelled sessions.
#
# Opens a tmux session named "cc-dashboard" with five panes side-by-side,
# each showing one orchestrator session. If the dashboard already exists,
# reattaches to it.
#
# Mouse: click to focus a pane, scroll wheel to scroll.
# Text selection: hold Shift while clicking/dragging (bypasses tmux mouse capture).
#
# Usage:
#   cc-dashboard [--labels "alan bert carla donna"]
#
# The optional --labels flag overrides the default four labels (order = left to right).

set -euo pipefail

DASHBOARD="cc-dashboard"
# `fran` is the experimental Codex sibling (ADR-0102) — her tmux session is
# named `fran` (own systemd unit fran.service, not treadmill-channel@).
LABELS=(treadmill-alan treadmill-bert treadmill-carla treadmill-donna treadmill-ernie fran)

# Parse optional --labels override
while [[ $# -gt 0 ]]; do
    case "$1" in
        --labels)
            read -ra LABELS <<< "$2"
            shift 2
            ;;
        *)
            echo "usage: cc-dashboard [--labels \"label1 label2 label3 label4\"]" >&2
            exit 1
            ;;
    esac
done

if [[ ${#LABELS[@]} -lt 2 ]]; then
    echo "cc-dashboard: need at least 2 labels" >&2
    exit 1
fi

# If the dashboard session already exists, just reattach.
if tmux has-session -t "$DASHBOARD" 2>/dev/null; then
    exec tmux attach-session -t "$DASHBOARD"
fi

# Attach to an inner session from inside a tmux pane.
# env -u TMUX unsets the outer-session marker so tmux allows the nested attach.
# Wrapped in a re-attach loop so when the inner session dies (e.g. systemd
# restart of the launcher after a `tmux kill-session` for MCP-channel recovery),
# the pane reconnects to the respawned session instead of stranding at a bash
# prompt with [exited]. The 1s sleep keeps the loop from spinning if the
# session can never be attached (typo'd label, killed tmux server).
attach_cmd() {
    echo "while :; do env -u TMUX tmux attach-session -t $1 2>/dev/null; sleep 1; done"
}

# Create a new detached session and start the first attach in pane 0.
tmux new-session -d -s "$DASHBOARD"
# Clean up a HALF-BUILT dashboard on ANY early exit during construction (set -e
# tripping on a failed split OR layout command), so the next run never reattaches
# to a partial session. Armed only for the session we just created — a
# pre-existing session took the reattach path above and never reaches here.
# Disarmed on successful completion, just before we attach.
trap 'tmux kill-session -t "$DASHBOARD" 2>/dev/null' EXIT
tmux send-keys -t "$DASHBOARD:0.0" "$(attach_cmd "${LABELS[0]}")" Enter

# Add one pane per remaining label. A single-orientation split ("-h") errors
# ("no room for new pane") once the terminal cannot fit another column, and a
# plain re-tile does NOT guarantee the next split fits either. So try horizontal,
# then vertical, then a tiled reflow; only if ALL fail is the terminal genuinely
# too small — in which case KILL the partial session (so the next run cannot
# reattach to a broken, incomplete dashboard — the silent-partial bug hit over
# SSH) and error with actionable guidance.
for label in "${LABELS[@]:1}"; do
    if ! tmux split-window -t "$DASHBOARD:0" -h 2>/dev/null \
       && ! tmux split-window -t "$DASHBOARD:0" -v 2>/dev/null; then
        tmux select-layout -t "$DASHBOARD:0" tiled 2>/dev/null
        if ! tmux split-window -t "$DASHBOARD:0" 2>/dev/null; then
            echo "cc-dashboard: this terminal is too small for ${#LABELS[@]} panes." >&2
            echo "  Show fewer, e.g.: cc-dashboard --labels \"treadmill-alan fran\"  — or use a larger window." >&2
            exit 1  # the EXIT trap removes the partial session
        fi
    fi
    tmux select-layout -t "$DASHBOARD:0" tiled
    tmux send-keys -t "$DASHBOARD:0" "$(attach_cmd "$label")" Enter
done

# Tiled arranges the panes into a grid that adapts to the terminal size.
tmux select-layout -t "$DASHBOARD:0" tiled

# Mouse: click to focus, scroll wheel to scroll, drag borders to resize.
tmux set-option -t "$DASHBOARD" mouse on

# Focus the leftmost pane.
tmux select-pane -t "$DASHBOARD:0.0"

# Construction succeeded — keep the session; disarm the cleanup trap.
trap - EXIT
exec tmux attach-session -t "$DASHBOARD"
